<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../props/common.props" />
  
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Specs</RootNamespace>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <OutputType>library</OutputType>
    <NoWarn>RS1038;RS1041</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOsPlatform('Windows'))">
    <DefineConstants>Is_Windows</DefineConstants>
  </PropertyGroup>

  <ItemGroup Label="Project under test">
    <ProjectReference Include="../../src/DotNetProjectFile.Analyzers/DotNetProjectFile.Analyzers.csproj" />
    <ProjectReference Include="../../src/DotNetProjectFile.RuleCatalog/DotNetProjectFile.RuleCatalog.csproj" />
  </ItemGroup>

  <ItemGroup Label="Test data">
    <ProjectReference Include="../TestData/TestData.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Buildalyzer" Version="9.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageReference Include="Microsoft.IO.Redist" Version="6.1.3" NoWarn="NU1701" />
  </ItemGroup>

  <ItemGroup Label="Test tools">
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="CodeAnalysis.TestTools" Version="5.1.0" />
    <PackageReference Include="NuGet.Common" Version="8.0.0" />
    <PackageReference Include="NuGet.Frameworks" Version="8.0.0" />
    <PackageReference Include="NuGet.Packaging" Version="8.0.0" />
    <PackageReference Include="NuGet.Protocol" Version="8.0.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="Verify" Version="33.4.0" />
    <PackageReference Include="Verify.NUnit" Version="33.4.0" />
  </ItemGroup>

  <ItemGroup Label="Build tools">
    <PackageReference PrivateAssets="all" Include="coverlet.collector" Version="10.1.0" />
    <PackageReference PrivateAssets="all" Include="Microsoft.Build.Tasks.Core" Version="18.4.0" />
    <PackageReference PrivateAssets="all" Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference PrivateAssets="all" Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <PropertyGroup>
    <SonarScannerVersion>11.3.0</SonarScannerVersion>
  </PropertyGroup>

  <ItemGroup Label="SonarScanner for .NET">
    <!-- Downloaded, not referenced: the specs run builds against the targets of the real scanner. -->
    <PackageDownload Include="dotnet-sonarscanner" Version="[$(SonarScannerVersion)]" />
    <AssemblyMetadata Include="SonarScanner" Value="$(NuGetPackageRoot)dotnet-sonarscanner/$(SonarScannerVersion)" />
  </ItemGroup>

  <ItemGroup Label="Test case C# files">
    <None Include="Cases/*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Label="Test projects">
    <None Visible="true" Include="../../projects/*/*.csproj" Link="Projects/C#/%(Filename)%(Extension)" />
    <None Visible="true" Include="../../projects/*/*.vbproj" Link="Projects/VB/%(Filename)%(Extension)" />
    <None Visible="true" Include="../../projects/*/*.resx" Link="Projects/RESX/%(Filename)%(Extension)" />
    <None Visible="true" Include="../../projects/*/*.props" Link="Projects/Props/%(Directory)/%(Filename)%(Extension)" />
  </ItemGroup>
  
  <ItemGroup Label="Analyzers">
    <PackageReference PrivateAssets="all" Include="AwesomeAssertions.Analyzers" Version="9.0.8" />
    <PackageReference PrivateAssets="all" Include="NUnit.Analyzers" Version="4.15.0" />
  </ItemGroup>

</Project>
