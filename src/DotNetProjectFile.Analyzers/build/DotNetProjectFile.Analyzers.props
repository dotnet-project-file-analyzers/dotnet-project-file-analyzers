<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import Project="$(MSBuildThisFileDirectory)CompilerVisible.props" />

  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)DotNetProjectFile.globalconfig" />
  </ItemGroup>

  <PropertyGroup>
    <SonarQubeIntegration Condition="$(SonarQubeIntegration) == ''">true</SonarQubeIntegration>
    <IsDotNetProjectFileSdk>false</IsDotNetProjectFileSdk>
    <IsDotNetProjectFileSdk Condition="$(MSBuildProjectFile) == '.net.csproj'">true</IsDotNetProjectFileSdk>
  </PropertyGroup>

  <!--
    SonarScanner for .NET collects the files it analyzes from the item types listed in
    $(SQAnalysisFileItemTypes). That list contains <None> and <Content>, but not
    <AdditionalFiles>, which is where this package registers the files it reports issues on.
    $(SQAdditionalAnalysisFileItemTypes) is the extension point to add to that list.

    Microsoft.Common.targets imports the targets of this package before it imports those of
    the scanner (via $(CustomAfterMicrosoftCommonTargets)), so this value is set in time.

    We define the MSBuild property simiar to Sonar but add AdditionalFiles.
  -->
  <PropertyGroup Condition="'$(SonarQubeIntegration)' == 'true'">
    <!-- enabled the proposed mechanism -->
    <SQAdditionalAnalysisFileItemTypes>$(SQAdditionalAnalysisFileItemTypes);AdditionalFiles</SQAdditionalAnalysisFileItemTypes>
  </PropertyGroup>

  <!-- Extend the additional files for the .net.csproj -->
  <Import
     Condition="$(IsDotNetProjectFileSdk) == 'true'"
     Project="$(MSBuildThisFileDirectory)AdditionalFiles.Sdk.props" />

  <Import
     Condition="$(IsDotNetProjectFileSdk) == 'true'"
     Project="$(MSBuildThisFileDirectory)DotNetProjectFile.Analyzers.Sdk.props" />

</Project>
