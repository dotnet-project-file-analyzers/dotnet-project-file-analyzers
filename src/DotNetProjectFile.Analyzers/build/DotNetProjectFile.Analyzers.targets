<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import Project="$(MSBuildThisFileDirectory)AdditionalFiles.targets" />

  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' or '$(MSBuildProjectExtension)' == '.vbproj'">
    <IsRoslynBased>true</IsRoslynBased>
  </PropertyGroup>

  <!--
    SonarScanner for .NET collects the files it analyzes from the item types
    listed in $(SQAnalysisFileItemTypes). That list already contains <None> and
    <Content>, but not <AdditionalFiles>, which is where this package registers
    the project files, props, targets, RESX files, and configuration files it
    reports issues on.

    $(SQAdditionalAnalysisFileItemTypes) is the extension point to add item types
    to that list. The targets of this package are imported by
    Microsoft.Common.targets, which imports the scanner targets (via
    $(CustomAfterMicrosoftCommonTargets)) at the very end, so this value is set
    before the scanner resolves $(SQAnalysisFileItemTypes).

    Registering the item type is preferred over copying every analyzed file into
    <Content>: <Content> is consumed by the build itself, which made the files
    show up while packing and publishing, broke scoped CSS discovery of the Razor
    SDK, and polluted the project tree of Visual Studio and Rider.
  -->
  <PropertyGroup Condition="'$(SonarQubeIntegration)' == 'true'">
    <SQAdditionalAnalysisFileItemTypes>$(SQAdditionalAnalysisFileItemTypes);AdditionalFiles</SQAdditionalAnalysisFileItemTypes>
  </PropertyGroup>

  <!--To inform users the SDK package is no longer needed. -->
  <Target Name="Proj1004" BeforeTargets="ResolvePackageAssets">
    <Warning
      Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'DotNetProjectFile.Analyzers.Sdk'))"
      Code="Proj1004"
      Text="The package reference to DotNetProjectFile.Analyzers.Sdk can be removed"
      HelpLink="https://dotnet-project-file-analyzers.github.io/rules/Proj1004.html" />
  </Target>

  <!--To inform users to use .net.csproj for not Roslyn-based languages such as F#. -->
  <Target Name="Proj1007" BeforeTargets="ResolvePackageAssets">
    <Warning
      Condition="
        '$(IsRoslynBased)' != 'true'
        and $([MSBuild]::GetPathOfFileAbove('.net.csproj', '$(MSBuildThisFileDirectory)')) == ''
        and '$(MSBuildProjectExtension)' != '.props'
        and '$(MSBuildProjectExtension)' != '.targets'"
      Code="Proj1007"
      Text="Use .net.csproj to analyze this project"
      HelpLink="https://dotnet-project-file-analyzers.github.io/rules/Proj1007.html" />
  </Target>

  <Target Name="ImportsAsAdditionalFiles" BeforeTargets="PrepareForBuild">
    
    <!-- Use XML peek to select the XPath values -->
    <XmlPeek
      XmlInputPath="$(MSBuildProjectFullPath)"
      Query="//*[local-name()='Import']/@Project">
      <Output TaskParameter="Result" ItemName="ImportedProjects" />
    </XmlPeek>

    <ItemGroup>
      <AdditionalFiles
        AnalyzerType="MSBuildProps"
        Include="@(ImportedProjects)"
        Exclude="@(AdditionalFiles)"
        Visible="false" />
    </ItemGroup>

  </Target>

</Project>
